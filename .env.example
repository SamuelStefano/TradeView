# Publicos: vao para o bundle do browser. Sao inofensivos porque toda tabela
# esta sob RLS default-deny e a chave publishable nao vale nada sem sessao.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NUNCA prefixar com NEXT_PUBLIC_. Ignora RLS por completo.
SUPABASE_SECRET_KEY=

# 32 bytes em base64: openssl rand -base64 32
# Cifra as credenciais de exchange. A chave nunca chega ao Postgres, entao um
# dump do banco sozinho nao devolve credencial utilizavel.
CREDENTIALS_ENCRYPTION_KEY=

# Trava de deploy para capital real. Junto com o flag por usuario no banco,
# sao dois gates independentes. Deixe ausente ou 'false' em qualquer ambiente
# que nao seja o seu proprio.
TRADEVIEW_ALLOW_REAL_TRADING=false

# Quem pode criar conta, separado por virgula. O projeto Supabase e
# compartilhado com outro app, entao cadastro aberto deixaria um estranho
# gravar ao lado do dado dele. Vazio ou ausente = ninguem se cadastra.
TRADEVIEW_SIGNUP_ALLOWLIST=
